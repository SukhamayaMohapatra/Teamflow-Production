NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/teamflow?retryWrites=true&w=majority
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-bytes
JWT_EXPIRES_IN=1d
CLIENT_ORIGIN=http://localhost:5173
COOKIE_SECURE=false
SEED_ADMIN_NAME=TeamFlow Admin
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=ChangeThisPassword123!
